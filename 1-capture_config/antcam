normalize_intra_setting_value() {
    local raw_value="${1:-}"
    local normalized_value
    normalized_value="$(normalize_upload_text_value "${raw_value}")"
    normalized_value="${normalized_value,,}"
    case "${normalized_value}" in
        none|off|default|auto|0)
            printf '%s\n' "none"
            return 0
            ;;
        *)
            [[ "${normalized_value}" =~ ^[0-9]+$ ]] || return 1
            [[ ! "${normalized_value}" =~ ^0+$ ]] || return 1
            printf '%s\n' "${normalized_value}"
            return 0
            ;;
    esac
}

normalize_photo_every_setting_value() {
    local raw_value="${1:-}"
    local normalized_value photo_every_ms
    normalized_value="$(normalize_duration_value "${raw_value}")"
    [[ -n "${normalized_value}" ]] || return 1

    if [[ "${normalized_value}" == "none" || "${normalized_value}" == "0" ]]; then
        printf '%s\n' "none"
        return 0
    fi

    is_valid_duration_value "${normalized_value}" || return 1
    photo_every_ms="$(duration_to_milliseconds "${normalized_value}" || true)"
    [[ -n "${photo_every_ms}" ]] || return 1
    if [[ "${photo_every_ms}" -le 0 ]]; then
        printf '%s\n' "none"
    else
        printf '%s\n' "${normalized_value}"
    fi
}

