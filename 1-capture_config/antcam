}

remove_old_managed_block() {
    local config_file="$1"
    local out_file="$2"
    awk -v begin="${BEGIN_MARKER}" -v end="${END_MARKER}" '
        $0 == begin { in_block = 1; next }
        $0 == end { in_block = 0; next }
        !in_block { print }
    ' "${config_file}" > "${out_file}"
}

remove_conflicting_camera_lines() {
    local in_file="$1"
    local out_file="$2"
    awk '
        /^[[:space:]]*camera_auto_detect[[:space:]]*=/ { next }
        /^[[:space:]]*dtoverlay=ov5647([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx219([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx477([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx296([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx708([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=ov64a40([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=arducam-64mp([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx290([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx378([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=ov9281([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx327([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx519([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=cma([[:space:]]|,|$)/ { next }
        { print }
    ' "${in_file}" > "${out_file}"
}

apply_profile() {
    local profile="$1"
    shift || true

    local dry_run="false"
    local no_reboot="false"
    while (($# > 0)); do
        case "$1" in
            --dry-run)
                dry_run="true"
                ;;
            --no-reboot)
                no_reboot="true"
                ;;
            *)
                die "unknown option for apply: $1"
                ;;
        esac
        shift
    done

    local config_file
    config_file="$(resolve_config_file)" || die "could not locate Raspberry Pi config.txt"

    local profile_block
    profile_block="$(render_profile_block "${profile}")"
    [[ -n "${profile_block//[[:space:]]/}" ]] || die "profile '${profile}' is empty"

    local current_block
    current_block="$(get_current_managed_block "${config_file}")"
    if [[ "${current_block}" == "${profile_block}" ]]; then
        echo "already configured: ${profile}"
        return 0
    fi

    if [[ "${dry_run}" != "true" && "$(id -u)" -ne 0 ]]; then
        die "apply requires root (use sudo)"
    fi

    local tmp_without_block tmp_cleaned
    tmp_without_block="$(mktemp)"
    tmp_cleaned="$(mktemp)"
    trap '[[ -n "${tmp_without_block:-}" ]] && rm -f -- "${tmp_without_block}"; [[ -n "${tmp_cleaned:-}" ]] && rm -f -- "${tmp_cleaned}"' EXIT

    remove_old_managed_block "${config_file}" "${tmp_without_block}"
    remove_conflicting_camera_lines "${tmp_without_block}" "${tmp_cleaned}"

    {
        cat "${tmp_cleaned}"
        printf '%s\n' "${BEGIN_MARKER}"
        printf '%s\n' "${profile_block}"
        printf '%s\n' "${END_MARKER}"
    } > "${tmp_without_block}"

    if [[ "${dry_run}" == "true" ]]; then
        echo "dry-run: would apply profile '${profile}' to ${config_file}"
        echo "----- managed block -----"
        printf '%s\n' "${BEGIN_MARKER}"
        printf '%s\n' "${profile_block}"
        printf '%s\n' "${END_MARKER}"
        return 0
    fi

    local backup_file="${config_file}.antcam.bak.$(date +%Y%m%d-%H%M%S)"
    cp "${config_file}" "${backup_file}"
    install -m 0644 "${tmp_without_block}" "${config_file}"
    sync

    echo "applied profile: ${profile}"
    echo "config: ${config_file}"
    echo "backup: ${backup_file}"

    if [[ "${no_reboot}" == "true" ]]; then
        echo "no reboot requested. reboot manually to apply firmware changes."
        return 0
    fi

    echo "rebooting to apply firmware changes..."
    systemctl reboot --no-block
}

read_focus_setting_for_home() {
    local user_home="$1"
    local focus_file focus_value
    focus_file="$(resolve_focus_value_file_for_home "${user_home}")"

    if [[ ! -f "${focus_file}" ]]; then
        printf '%s\n' "auto"
        return 0
    fi

    focus_value="$(head -n 1 "${focus_file}" 2>/dev/null | tr -d '[:space:]' || true)"
    if is_auto_focus_value "${focus_value}"; then
        printf '%s\n' "auto"
        return 0
    fi

    is_valid_lens_position_value "${focus_value}" || die "invalid focus value in ${focus_file}: ${focus_value} (expected numeric lens-position or 'auto')"
    printf '%s\n' "${focus_value}"
}

read_fps_setting_for_home() {
    local user_home="$1"
    local fps_file fps_value
    fps_file="$(resolve_fps_value_file_for_home "${user_home}")"

    if [[ ! -f "${fps_file}" ]]; then
        printf '%s\n' "${DEFAULT_RECORDING_FPS}"
        return 0
    fi

    fps_value="$(head -n 1 "${fps_file}" 2>/dev/null | tr -d '[:space:]' || true)"
    is_valid_fps_value "${fps_value}" || die "invalid fps value in ${fps_file}: ${fps_value}"
    printf '%s\n' "${fps_value}"
}

read_length_setting_for_home() {
    local user_home="$1"
    local length_file length_value
    length_file="$(resolve_length_value_file_for_home "${user_home}")"

    if [[ ! -f "${length_file}" ]]; then
        printf '%s\n' "${DEFAULT_RECORDING_LENGTH}"
        return 0
    fi

    length_value="$(head -n 1 "${length_file}" 2>/dev/null | tr -d '[:space:]' || true)"
    is_valid_duration_value "${length_value}" || die "invalid length value in ${length_file}: ${length_value} (expected format like 30h, 10m, 45s, or 1h30m)"
    printf '%s\n' "$(normalize_duration_value "${length_value}")"
}

read_segment_setting_for_home() {
    local user_home="$1"
    local segment_file segment_value segment_ms
    segment_file="$(resolve_segment_value_file_for_home "${user_home}")"

    if [[ ! -f "${segment_file}" ]]; then
        printf '%s\n' "${DEFAULT_RECORDING_SEGMENT}"
        return 0
    fi

    segment_value="$(head -n 1 "${segment_file}" 2>/dev/null | tr -d '[:space:]' || true)"
