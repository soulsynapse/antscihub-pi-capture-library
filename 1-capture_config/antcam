canonical_path_value() {
    local input_path="$1"

    if command -v python3 >/dev/null 2>&1; then
        python3 - "$input_path" <<'PY' 2>/dev/null || true
import os
import sys
print(os.path.realpath(sys.argv[1]))
PY
        return 0
    fi

    if command -v realpath >/dev/null 2>&1; then
        realpath "${input_path}" 2>/dev/null || printf '%s\n' "${input_path}"
        return 0
    fi

    printf '%s\n' "${input_path}"
}

is_path_within_directory() {
    local check_path="$1"
    local base_dir="$2"
    local check_real base_real
    check_real="$(canonical_path_value "${check_path}")"
    base_real="$(canonical_path_value "${base_dir}")"
    [[ -n "${check_real}" && -n "${base_real}" ]] || return 1

    case "${check_real}" in
        "${base_real}"|${base_real}/*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

