read_segment_setting_for_home() {
    local user_home="$1"
    local segment_file segment_value segment_ms
    segment_file="$(resolve_segment_value_file_for_home "${user_home}")"

    if [[ ! -f "${segment_file}" ]]; then
        printf '%s\n' "${DEFAULT_RECORDING_SEGMENT}"
        return 0
    fi

    segment_value="$(head -n 1 "${segment_file}" 2>/dev/null | tr -d '[:space:]' || true)"
    is_valid_duration_value "${segment_value}" || die "invalid segment value in ${segment_file}: ${segment_value} (expected format like 30h, 10m, 45s, or 1h30m)"
    segment_ms="$(duration_to_milliseconds "${segment_value}")"
    [[ "${segment_ms}" -gt 0 ]] || die "invalid segment value in ${segment_file}: ${segment_value} (must be greater than 0)"
    printf '%s\n' "$(normalize_duration_value "${segment_value}")"
}

