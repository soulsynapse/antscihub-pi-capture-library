[Unit]
Description=AntSciHub Upload Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/path/to/4-upload/upload_worker.sh
WorkingDirectory=/path/to/repo
# Set to the account that owns Desktop/5-UPLOAD and rclone config.
# install.sh writes this automatically based on the real device user.
User=REPLACE_WITH_REAL_USER
Environment="HOME=/home/REPLACE_WITH_REAL_USER"
Environment="RCLONE_REMOTE=gdrive_personal"
# Empty means remote root.
Environment="RCLONE_PATH="
Environment="UPLOAD_DIR=/home/REPLACE_WITH_REAL_USER/Desktop/5-UPLOAD"
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Override in a drop-in if needed:
# sudo systemctl edit antscihub-upload.service

[Install]
WantedBy=multi-user.target
