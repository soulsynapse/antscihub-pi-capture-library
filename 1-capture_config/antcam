require_profile_dir() {
    [[ -d "${PROFILE_DIR}" ]] || die "profile directory not found: ${PROFILE_DIR}"
}

resolve_config_file() {
    local candidate
    for candidate in "${CONFIG_CANDIDATES[@]}"; do
        if [[ -f "${candidate}" ]]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done
    return 1
}

sanitize_profile_name() {
    local name="$1"
    [[ "${name}" =~ ^[a-zA-Z0-9._-]+$ ]] || die "invalid profile name: ${name}"
}

profile_path() {
    local profile="$1"
    sanitize_profile_name "${profile}"
    local path="${PROFILE_DIR}/${profile}.conf"
    [[ -f "${path}" ]] || die "profile not found: ${profile}"
    printf '%s\n' "${path}"
}

home_for_user() {
    local username="$1"
    local user_home
    if command -v getent >/dev/null 2>&1; then
        user_home="$(getent passwd "$username" 2>/dev/null | cut -d: -f6 || true)"
    else
        user_home="$(awk -F: -v user="$username" '$1 == user { print $6; exit }' /etc/passwd 2>/dev/null || true)"
    fi
    [[ -n "${user_home}" ]] || return 1
    printf '%s\n' "${user_home}"
}

resolve_upload_service_user() {
    local service_user=""
    command -v systemctl >/dev/null 2>&1 || return 1

    service_user="$(systemctl show "${DEFAULT_UPLOAD_SERVICE_NAME}" -p User --value 2>/dev/null || true)"
    service_user="$(printf '%s' "${service_user}" | tr -d '[:space:]')"
    [[ -n "${service_user}" ]] || return 1
    [[ "${service_user}" != "root" ]] || return 1
    printf '%s\n' "${service_user}"
}

resolve_effective_user() {
    if [[ -n "${ANTCAM_EFFECTIVE_USER:-}" ]]; then
        printf '%s\n' "${ANTCAM_EFFECTIVE_USER}"
        return 0
    fi

    if [[ "$(id -u)" -eq 0 ]]; then
        if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
            printf '%s\n' "${SUDO_USER}"
            return 0
        fi

        local service_user
        if service_user="$(resolve_upload_service_user)"; then
            printf '%s\n' "${service_user}"
            return 0
        fi
    fi

    id -un
}

resolve_effective_home() {
    if [[ -n "${ANTCAM_EFFECTIVE_HOME:-}" ]]; then
        printf '%s\n' "${ANTCAM_EFFECTIVE_HOME}"
        return 0
    fi

    local effective_user effective_home
    effective_user="$(resolve_effective_user || true)"
    if [[ -n "${effective_user}" ]]; then
        if effective_home="$(home_for_user "${effective_user}")"; then
            printf '%s\n' "${effective_home}"
            return 0
        fi
    fi

    if [[ -n "${HOME:-}" ]]; then
        printf '%s\n' "${HOME}"
        return 0
    fi

    local current_user
    current_user="$(id -un)"
    home_for_user "${current_user}"
}

is_service_execution_context() {
    if [[ -n "${INVOCATION_ID:-}" || -n "${JOURNAL_STREAM:-}" ]]; then
        return 0
    fi

    if [[ "$(id -u)" -eq 0 && ( -z "${SUDO_USER:-}" || "${SUDO_USER}" == "root" ) ]]; then
        return 0
    fi

    return 1
}

resolve_desktop_dir_for_home() {
    local user_home="$1"
    local desktop=""
    local user_dirs_file="${user_home}/.config/user-dirs.dirs"

    if [[ -f "${user_dirs_file}" ]]; then
        local desktop_line
        desktop_line="$(grep -E '^XDG_DESKTOP_DIR=' "${user_dirs_file}" | tail -n 1 || true)"
        if [[ -n "${desktop_line}" ]]; then
            desktop="${desktop_line#XDG_DESKTOP_DIR=}"
            desktop="${desktop%\"}"
            desktop="${desktop#\"}"
            desktop="${desktop//\$HOME/${user_home}}"
            if [[ "${desktop}" != /* ]]; then
                desktop="${user_home}/${desktop#./}"
            fi
        fi
    fi

    if [[ -z "${desktop}" ]]; then
        if [[ -d "${user_home}/Desktop" ]]; then
            desktop="${user_home}/Desktop"
        elif [[ -d "${user_home}/desktop" ]]; then
            desktop="${user_home}/desktop"
        else
            desktop="${user_home}/Desktop"
        fi
    fi

    printf '%s\n' "${desktop%/}"
}

