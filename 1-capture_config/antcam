compact_report_text_for_event() {
    local input="${1:-}"
    local max_chars="${2:-700}"
    local text=""

    [[ "${max_chars}" =~ ^[0-9]+$ ]] || max_chars=700
    if [[ "${max_chars}" -le 0 ]]; then
        printf '%s' ""
        return 0
    fi

    if command -v python3 >/dev/null 2>&1; then
        text="$(
            printf '%s' "${input}" | python3 -c '
import re
import sys

max_chars = int(sys.argv[1])
text = sys.stdin.read().replace("\x00", " ")
text = text.replace("\r\n", "\n").replace("\r", "\n")
lines = [re.sub(r"\s+", " ", line).strip() for line in text.splitlines()]
text = " | ".join(line for line in lines if line)
text = re.sub(
    r"(?i)\b(authorization|password|passwd|token|access[_-]?token|refresh[_-]?token|client[_-]?secret|secret)=\S+",
    r"\1=<redacted>",
    text,
)
text = re.sub(
    r"(?i)\b(authorization:\s*(?:bearer|basic)\s+)\S+",
    r"\1<redacted>",
    text,
)
if len(text) > max_chars:
    text = text[: max_chars - 3].rstrip() + "..."
print(text, end="")
' "${max_chars}" 2>/dev/null || true
        )"
    fi

    if [[ -z "${text}" && -n "${input}" ]]; then
        text="$(printf '%s' "${input}" | tr '\r\n\t' '   ' | sed -E 's/[[:space:]]+/ /g; s/^[[:space:]]+//; s/[[:space:]]+$//' 2>/dev/null || true)"
        if [[ -z "${text}" ]]; then
            text="${input//$'\r'/ }"
            text="${text//$'\n'/ }"
            text="${text//$'\t'/ }"
        fi
        if [[ "${#text}" -gt "${max_chars}" ]]; then
            text="${text:0:$((max_chars - 3))}..."
        fi
    fi

    printf '%s' "${text}"
}

