#!/usr/bin/env bash
set -euo pipefail

BEGIN_MARKER="# antscihub-capture-config BEGIN"
END_MARKER="# antscihub-capture-config END"

DEFAULT_PROFILE_DIR="/etc/antscihub/camera-profiles"
PROFILE_DIR="${ANTCAM_PROFILE_DIR:-${ANTSCAM_PROFILE_DIR:-${DEFAULT_PROFILE_DIR}}}"
FLEET_EVENT_TOPIC_TEMPLATE="${FLEET_EVENT_TOPIC_TEMPLATE:-fleet/report/{DEVICE_ID}}"
FLEET_PUBLISH_BIN="${FLEET_PUBLISH_BIN:-fleet-publish}"
MQTT_REPORT_BIN="${MQTT_REPORT_BIN:-mqtt_report.py}"
MQTT_EVENT_ENABLED="${MQTT_EVENT_ENABLED:-true}"
DEVICE_ID_CACHE=""
DEVICE_ID_CACHE_READY="false"
MQTT_PUBLISH_WARNING_EMITTED="false"

CONFIG_CANDIDATES=(
    /boot/firmware/config.txt
    /boot/config.txt
)

usage() {
    cat <<'EOF'
Usage:
  sudo antcam list
  sudo antcam current
  sudo antcam show <profile>
  sudo antcam apply <profile> [--dry-run] [--no-reboot]
  antcam start
  antcam test

Profiles are loaded from:
  /etc/antscihub/camera-profiles

Examples:
  sudo antcam list
  sudo antcam show imx708
  sudo antcam apply imx708
  sudo antcam apply auto --dry-run
  antcam start
  antcam test
EOF
}

die() {
    echo "antcam: $*" >&2
    exit 1
}

require_profile_dir() {
    [[ -d "${PROFILE_DIR}" ]] || die "profile directory not found: ${PROFILE_DIR}"
}

resolve_config_file() {
    local candidate
    for candidate in "${CONFIG_CANDIDATES[@]}"; do
        if [[ -f "${candidate}" ]]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done
    return 1
}

sanitize_profile_name() {
    local name="$1"
    [[ "${name}" =~ ^[a-zA-Z0-9._-]+$ ]] || die "invalid profile name: ${name}"
}

profile_path() {
    local profile="$1"
    sanitize_profile_name "${profile}"
    local path="${PROFILE_DIR}/${profile}.conf"
    [[ -f "${path}" ]] || die "profile not found: ${profile}"
    printf '%s\n' "${path}"
}

home_for_user() {
    local username="$1"
    local user_home
    if command -v getent >/dev/null 2>&1; then
        user_home="$(getent passwd "$username" 2>/dev/null | cut -d: -f6 || true)"
    else
        user_home="$(awk -F: -v user="$username" '$1 == user { print $6; exit }' /etc/passwd 2>/dev/null || true)"
    fi
    [[ -n "${user_home}" ]] || return 1
    printf '%s\n' "${user_home}"
}

resolve_effective_home() {
    if [[ "$(id -u)" -eq 0 && -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
        local sudo_home
        if sudo_home="$(home_for_user "${SUDO_USER}")"; then
            printf '%s\n' "${sudo_home}"
            return 0
        fi
    fi

    if [[ -n "${HOME:-}" ]]; then
        printf '%s\n' "${HOME}"
        return 0
    fi

    local current_user
    current_user="$(id -un)"
    home_for_user "${current_user}"
}

resolve_desktop_dir_for_home() {
    local user_home="$1"
    local desktop=""
    local user_dirs_file="${user_home}/.config/user-dirs.dirs"

    if [[ -f "${user_dirs_file}" ]]; then
        local desktop_line
        desktop_line="$(grep -E '^XDG_DESKTOP_DIR=' "${user_dirs_file}" | tail -n 1 || true)"
        if [[ -n "${desktop_line}" ]]; then
            desktop="${desktop_line#XDG_DESKTOP_DIR=}"
            desktop="${desktop%\"}"
            desktop="${desktop#\"}"
            desktop="${desktop//\$HOME/${user_home}}"
            if [[ "${desktop}" != /* ]]; then
                desktop="${user_home}/${desktop#./}"
            fi
        fi
    fi

    if [[ -z "${desktop}" ]]; then
        if [[ -d "${user_home}/Desktop" ]]; then
            desktop="${user_home}/Desktop"
        elif [[ -d "${user_home}/desktop" ]]; then
            desktop="${user_home}/desktop"
        else
            desktop="${user_home}/Desktop"
        fi
    fi

    printf '%s\n' "${desktop%/}"
}

json_escape() {
    local input="${1:-}"
    input="${input//\\/\\\\}"
    input="${input//\"/\\\"}"
    input="${input//$'\n'/\\n}"
    input="${input//$'\r'/\\r}"
    input="${input//$'\t'/\\t}"
    printf '%s' "${input}"
}

normalize_device_id() {
    local input="${1:-}"
    input="${input//$'\r'/}"
    input="${input//$'\n'/}"
    input="${input//$'\t'/}"
    input="${input// /}"
    printf '%s' "${input}"
}

detect_device_id_fallback() {
    local raw=""
    raw="$(hostname 2>/dev/null || true)"
    if [[ -z "$raw" && -f /etc/hostname ]]; then
        raw="$(head -n 1 /etc/hostname 2>/dev/null || true)"
    fi
    if [[ -z "$raw" && -f /etc/machine-id ]]; then
        raw="$(head -n 1 /etc/machine-id 2>/dev/null || true)"
    fi
    raw="${raw//[^[:alnum:]._-]/_}"
    raw="${raw//__/_}"
    raw="${raw##_}"
    raw="${raw%%_}"
    if [[ -z "$raw" ]]; then
        raw="unknown-device"
    fi
    printf '%s' "$raw"
}

resolve_device_id() {
    if [[ "${DEVICE_ID_CACHE_READY}" == "true" ]]; then
        printf '%s' "${DEVICE_ID_CACHE}"
        return 0
    fi

    local candidate=""
    if [[ -n "${DEVICE_ID:-}" ]]; then
        candidate="$(normalize_device_id "${DEVICE_ID}")"
    elif [[ -n "${FLEET_DEVICE_ID:-}" ]]; then
        candidate="$(normalize_device_id "${FLEET_DEVICE_ID}")"
    fi

    if [[ -z "${candidate}" ]] && command -v "${FLEET_PUBLISH_BIN}" >/dev/null 2>&1; then
        candidate="$("${FLEET_PUBLISH_BIN}" --device-id 2>/dev/null | head -n 1 || true)"
        candidate="$(normalize_device_id "${candidate}")"
        if [[ "${candidate}" == *=* ]]; then
            candidate="${candidate##*=}"
            candidate="$(normalize_device_id "${candidate}")"
        fi
        if [[ -z "${candidate}" ]]; then
            candidate="$("${FLEET_PUBLISH_BIN}" device-id 2>/dev/null | head -n 1 || true)"
            candidate="$(normalize_device_id "${candidate}")"
            if [[ "${candidate}" == *=* ]]; then
                candidate="${candidate##*=}"
                candidate="$(normalize_device_id "${candidate}")"
            fi
        fi
    fi

    if [[ -z "${candidate}" ]] && command -v python3 >/dev/null 2>&1; then
        candidate="$(python3 - <<'PY' 2>/dev/null || true
try:
    from mqtt_client import DEVICE_ID
    print((DEVICE_ID or "").strip())
except Exception:
    pass
PY
)"
        candidate="$(normalize_device_id "${candidate}")"
    fi

    if [[ -z "${candidate}" ]]; then
        local file_candidate
        for file_candidate in \
            "/etc/fleet/device_id" \
            "/var/lib/fleet/device_id" \
            "${XDG_CONFIG_HOME:-${HOME}/.config}/fleet/device_id" \
            "/etc/antscihub/device_id"; do
            if [[ -f "${file_candidate}" ]]; then
                candidate="$(head -n 1 "${file_candidate}" 2>/dev/null || true)"
                candidate="$(normalize_device_id "${candidate}")"
                [[ -n "${candidate}" ]] && break
            fi
        done
    fi

    if [[ -z "${candidate}" ]]; then
        candidate="$(detect_device_id_fallback)"
    fi

    DEVICE_ID_CACHE="${candidate}"
    DEVICE_ID_CACHE_READY="true"
    printf '%s' "${DEVICE_ID_CACHE}"
}

build_fleet_event_topic() {
    local device_id="$1"
    local template="${FLEET_EVENT_TOPIC_TEMPLATE}"
    local topic

    topic="${template//\{DEVICE_ID\}/${device_id}}"
    if [[ -z "${topic}" ]]; then
        topic="fleet/report/${device_id}"
    fi

    printf '%s' "${topic}"
}

publish_with_fleet_publish() {
    local topic="$1"
    local payload="$2"

    command -v "${FLEET_PUBLISH_BIN}" >/dev/null 2>&1 || return 1

    "${FLEET_PUBLISH_BIN}" --topic "${topic}" --json "${payload}" >/dev/null 2>&1 && return 0
    "${FLEET_PUBLISH_BIN}" --topic "${topic}" --payload "${payload}" >/dev/null 2>&1 && return 0
    "${FLEET_PUBLISH_BIN}" --topic "${topic}" --message "${payload}" >/dev/null 2>&1 && return 0
    "${FLEET_PUBLISH_BIN}" -t "${topic}" -m "${payload}" >/dev/null 2>&1 && return 0

    return 1
}

publish_with_mqtt_report_cli() {
    local topic="$1"
    local payload="$2"

    command -v "${MQTT_REPORT_BIN}" >/dev/null 2>&1 || return 1
    "${MQTT_REPORT_BIN}" --topic "${topic}" --json "${payload}" >/dev/null 2>&1
}

publish_with_fleet_mqtt_python() {
    local topic="$1"
    local payload="$2"

    command -v python3 >/dev/null 2>&1 || return 1

    python3 - "${topic}" "${payload}" >/dev/null 2>&1 <<'PY'
import json
import sys

topic = sys.argv[1]
payload_raw = sys.argv[2]

try:
    payload_obj = json.loads(payload_raw)
except Exception:
    payload_obj = payload_raw

published = False

try:
    from mqtt_client import fleet
    try:
        if hasattr(fleet, "loop_start"):
            fleet.loop_start()
        if hasattr(fleet, "wait_until_connected"):
            fleet.wait_until_connected(timeout=10)
    except Exception:
        pass
    try:
        fleet.publish(topic, payload_obj, encrypt=True)
    except TypeError:
        fleet.publish(topic, payload_obj)
    published = True
except Exception:
    published = False

if not published:
    try:
        from mqtt_client import FleetMQTT
    except Exception:
        sys.exit(2)

    client = None
    for ctor in (lambda: FleetMQTT(), lambda: FleetMQTT("antscihub-recording")):
        try:
            client = ctor()
            break
        except Exception:
            continue

    if client is None:
        sys.exit(3)

    for method_name in ("publish_json", "publish", "send"):
        method = getattr(client, method_name, None)
        if not callable(method):
            continue
        try:
            if method_name == "publish_json":
                if isinstance(payload_obj, str):
                    parsed_payload = json.loads(payload_obj)
                else:
                    parsed_payload = payload_obj
                try:
                    method(topic, parsed_payload, encrypt=True)
                except TypeError:
                    method(topic, parsed_payload)
            else:
                try:
                    method(topic, payload_obj, encrypt=True)
                except TypeError:
                    try:
                        method(topic, payload_obj)
                    except TypeError:
                        method(topic, payload_raw)
            published = True
            break
        except Exception:
            continue

    for close_name in ("close", "disconnect", "stop"):
        close_method = getattr(client, close_name, None)
        if callable(close_method):
            try:
                close_method()
            except Exception:
                pass

sys.exit(0 if published else 4)
PY
}

publish_recording_event() {
    local report_name="$1"
    local severity="$2"
    local message="$3"
    local success_bool="$4"
    local capture_dir="${5:-}"
    local script_path="${6:-}"
    local exit_code="${7:-}"

    if [[ "${MQTT_EVENT_ENABLED,,}" != "true" ]]; then
        return 0
    fi

    local device_id topic timestamp payload
    resolve_device_id >/dev/null
    device_id="${DEVICE_ID_CACHE}"
    topic="$(build_fleet_event_topic "${device_id}")"
    timestamp="$(date +%s)"

    payload="{\"event\":\"report\""
    payload+=",\"report\":\"$(json_escape "${report_name}")\""
    payload+=",\"device_id\":\"$(json_escape "${device_id}")\""
    payload+=",\"timestamp\":${timestamp}"
    payload+=",\"severity\":\"$(json_escape "${severity}")\""
    payload+=",\"message\":\"$(json_escape "${message}")\""
    payload+=",\"success\":${success_bool}"
    payload+=",\"service\":\"antscihub-recording\""
    if [[ -n "${capture_dir}" ]]; then
        payload+=",\"folder\":\"$(json_escape "${capture_dir}")\""
    fi
    if [[ -n "${script_path}" ]]; then
        payload+=",\"script\":\"$(json_escape "${script_path}")\""
    fi
    if [[ -n "${exit_code}" ]]; then
        payload+=",\"exit_code\":\"$(json_escape "${exit_code}")\""
    fi
    payload+="}"

    if publish_with_fleet_publish "${topic}" "${payload}"; then
        return 0
    fi
    if publish_with_mqtt_report_cli "${topic}" "${payload}"; then
        return 0
    fi
    if publish_with_fleet_mqtt_python "${topic}" "${payload}"; then
        return 0
    fi

    if [[ "${MQTT_PUBLISH_WARNING_EMITTED}" != "true" ]]; then
        echo "antcam: warning: unable to publish recording MQTT events (tried ${FLEET_PUBLISH_BIN}, ${MQTT_REPORT_BIN}, python mqtt_client)" >&2
        MQTT_PUBLISH_WARNING_EMITTED="true"
    fi
    return 1
}

normalize_lines() {
    awk '
        {
            sub(/\r$/, "", $0)
        }
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        {
            gsub(/[[:space:]]+$/, "", $0)
            print
        }
    '
}

render_profile_block() {
    local profile="$1"
    local path
    path="$(profile_path "${profile}")"
    normalize_lines < "${path}"
}

get_current_managed_block() {
    local config_file="$1"
    awk -v begin="${BEGIN_MARKER}" -v end="${END_MARKER}" '
        $0 == begin { in_block = 1; next }
        $0 == end { in_block = 0; next }
        in_block { print }
    ' "${config_file}" | normalize_lines
}

list_profiles() {
    require_profile_dir
    local file name desc
    shopt -s nullglob
    local files=("${PROFILE_DIR}"/*.conf)
    shopt -u nullglob

    if (( ${#files[@]} == 0 )); then
        die "no profiles found in ${PROFILE_DIR}"
    fi

    for file in "${files[@]}"; do
        name="$(basename "${file}" .conf)"
        desc="$(awk '/^[[:space:]]*#/ { sub(/^[[:space:]]*#[[:space:]]*/, "", $0); print; exit }' "${file}")"
        if [[ -n "${desc}" ]]; then
            printf '%s - %s\n' "${name}" "${desc}"
        else
            printf '%s\n' "${name}"
        fi
    done | sort
}

current_profile_name() {
    require_profile_dir
    local config_file
    config_file="$(resolve_config_file)" || die "could not locate Raspberry Pi config.txt"

    local current_block
    current_block="$(get_current_managed_block "${config_file}")"
    if [[ -z "${current_block//[[:space:]]/}" ]]; then
        echo "unmanaged"
        return 0
    fi

    local file name profile_block
    shopt -s nullglob
    local files=("${PROFILE_DIR}"/*.conf)
    shopt -u nullglob

    for file in "${files[@]}"; do
        name="$(basename "${file}" .conf)"
        profile_block="$(render_profile_block "${name}")"
        if [[ "${current_block}" == "${profile_block}" ]]; then
            echo "${name}"
            return 0
        fi
    done

    echo "custom-managed"
}

show_profile() {
    local profile="$1"
    render_profile_block "${profile}"
}

remove_old_managed_block() {
    local config_file="$1"
    local out_file="$2"
    awk -v begin="${BEGIN_MARKER}" -v end="${END_MARKER}" '
        $0 == begin { in_block = 1; next }
        $0 == end { in_block = 0; next }
        !in_block { print }
    ' "${config_file}" > "${out_file}"
}

remove_conflicting_camera_lines() {
    local in_file="$1"
    local out_file="$2"
    awk '
        /^[[:space:]]*camera_auto_detect[[:space:]]*=/ { next }
        /^[[:space:]]*dtoverlay=ov5647([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx219([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx477([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx296([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx708([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=ov64a40([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=arducam-64mp([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx290([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx378([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=ov9281([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx327([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=imx519([[:space:]]|,|$)/ { next }
        /^[[:space:]]*dtoverlay=cma([[:space:]]|,|$)/ { next }
        { print }
    ' "${in_file}" > "${out_file}"
}

apply_profile() {
    local profile="$1"
    shift || true

    local dry_run="false"
    local no_reboot="false"
    while (($# > 0)); do
        case "$1" in
            --dry-run)
                dry_run="true"
                ;;
            --no-reboot)
                no_reboot="true"
                ;;
            *)
                die "unknown option for apply: $1"
                ;;
        esac
        shift
    done

    local config_file
    config_file="$(resolve_config_file)" || die "could not locate Raspberry Pi config.txt"

    local profile_block
    profile_block="$(render_profile_block "${profile}")"
    [[ -n "${profile_block//[[:space:]]/}" ]] || die "profile '${profile}' is empty"

    local current_block
    current_block="$(get_current_managed_block "${config_file}")"
    if [[ "${current_block}" == "${profile_block}" ]]; then
        echo "already configured: ${profile}"
        return 0
    fi

    if [[ "${dry_run}" != "true" && "$(id -u)" -ne 0 ]]; then
        die "apply requires root (use sudo)"
    fi

    local tmp_without_block tmp_cleaned
    tmp_without_block="$(mktemp)"
    tmp_cleaned="$(mktemp)"
    trap '[[ -n "${tmp_without_block:-}" ]] && rm -f -- "${tmp_without_block}"; [[ -n "${tmp_cleaned:-}" ]] && rm -f -- "${tmp_cleaned}"' EXIT

    remove_old_managed_block "${config_file}" "${tmp_without_block}"
    remove_conflicting_camera_lines "${tmp_without_block}" "${tmp_cleaned}"

    {
        cat "${tmp_cleaned}"
        printf '%s\n' "${BEGIN_MARKER}"
        printf '%s\n' "${profile_block}"
        printf '%s\n' "${END_MARKER}"
    } > "${tmp_without_block}"

    if [[ "${dry_run}" == "true" ]]; then
        echo "dry-run: would apply profile '${profile}' to ${config_file}"
        echo "----- managed block -----"
        printf '%s\n' "${BEGIN_MARKER}"
        printf '%s\n' "${profile_block}"
        printf '%s\n' "${END_MARKER}"
        return 0
    fi

    local backup_file="${config_file}.antcam.bak.$(date +%Y%m%d-%H%M%S)"
    cp "${config_file}" "${backup_file}"
    install -m 0644 "${tmp_without_block}" "${config_file}"
    sync

    echo "applied profile: ${profile}"
    echo "config: ${config_file}"
    echo "backup: ${backup_file}"

    if [[ "${no_reboot}" == "true" ]]; then
        echo "no reboot requested. reboot manually to apply firmware changes."
        return 0
    fi

    echo "rebooting to apply firmware changes..."
    systemctl reboot --no-block
}

start_recording() {
    local user_home
    user_home="$(resolve_effective_home)" || die "could not resolve user home for recording path"

    local desktop_dir capture_dir record_script experiment_file
    desktop_dir="$(resolve_desktop_dir_for_home "${user_home}")"
    capture_dir="${desktop_dir}/4-CAPTURE"
    record_script="${capture_dir}/record.sh"
    experiment_file="${capture_dir}/experiment.txt"

    if [[ ! -d "${capture_dir}" ]]; then
        mkdir -p "${capture_dir}"
        echo "created capture directory: ${capture_dir}"
    fi

    if [[ ! -e "${record_script}" ]]; then
        touch "${record_script}"
        echo "created empty recording script: ${record_script}"
    fi

    if [[ ! -e "${experiment_file}" ]]; then
        touch "${experiment_file}"
        echo "created empty experiment file: ${experiment_file}"
    fi

    [[ -f "${record_script}" ]] || die "recording script path is not a file: ${record_script}"
    [[ -f "${experiment_file}" ]] || die "experiment file path is not a file: ${experiment_file}"

    echo "capture directory: ${capture_dir}"
    echo "experiment file: ${experiment_file}"
    echo "starting recording script: ${record_script}"

    publish_recording_event \
        "recording_start" \
        "ATTENTION" \
        "Recording script starting" \
        "true" \
        "${capture_dir}" \
        "${record_script}" || true

    local record_exit_code=0

    (
        cd "${capture_dir}"
        EXPERIMENT_FILE="${experiment_file}" bash "./record.sh"
    ) || record_exit_code=$?

    if [[ "${record_exit_code}" -eq 0 ]]; then
        publish_recording_event \
            "recording_end" \
            "INFO" \
            "Recording script completed" \
            "true" \
            "${capture_dir}" \
            "${record_script}" \
            "${record_exit_code}" || true
    else
        publish_recording_event \
            "recording_end" \
            "ERROR" \
            "Recording script failed" \
            "false" \
            "${capture_dir}" \
            "${record_script}" \
            "${record_exit_code}" || true
    fi

    return "${record_exit_code}"
}

start_test() {
    local user_home
    user_home="$(resolve_effective_home)" || die "could not resolve user home for test path"

    local desktop_dir capture_dir test_script
    desktop_dir="$(resolve_desktop_dir_for_home "${user_home}")"
    capture_dir="${desktop_dir}/4-CAPTURE"
    test_script="${capture_dir}/test.sh"

    [[ -d "${capture_dir}" ]] || die "capture directory not found: ${capture_dir}"
    [[ -f "${test_script}" ]] || die "test script not found: ${test_script}"

    echo "capture directory: ${capture_dir}"
    echo "starting test script: ${test_script}"

    publish_recording_event \
        "test_start" \
        "ATTENTION" \
        "Test script starting" \
        "true" \
        "${capture_dir}" \
        "${test_script}" || true

    local test_exit_code=0

    (
        cd "${capture_dir}"
        bash "./test.sh"
    ) || test_exit_code=$?

    if [[ "${test_exit_code}" -eq 0 ]]; then
        publish_recording_event \
            "test_end" \
            "INFO" \
            "Test script completed" \
            "true" \
            "${capture_dir}" \
            "${test_script}" \
            "${test_exit_code}" || true
    else
        publish_recording_event \
            "test_end" \
            "ERROR" \
            "Test script failed" \
            "false" \
            "${capture_dir}" \
            "${test_script}" \
            "${test_exit_code}" || true
    fi

    return "${test_exit_code}"
}

main() {
    local cmd="${1:-}"
    case "${cmd}" in
        list)
            shift
            [[ $# -eq 0 ]] || die "list takes no arguments"
            list_profiles
            ;;
        current)
            shift
            [[ $# -eq 0 ]] || die "current takes no arguments"
            current_profile_name
            ;;
        show)
            shift
            [[ $# -eq 1 ]] || die "usage: antcam show <profile>"
            show_profile "$1"
            ;;
        apply)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam apply <profile> [--dry-run] [--no-reboot]"
            local profile="$1"
            shift
            apply_profile "${profile}" "$@"
            ;;
        start)
            shift
            [[ $# -eq 0 ]] || die "start takes no arguments"
            start_recording
            ;;
        test)
            shift
            [[ $# -eq 0 ]] || die "test takes no arguments"
            start_test
            ;;
        help|-h|--help|"")
            usage
            ;;
        *)
            die "unknown command: ${cmd}"
            ;;
    esac
}

main "$@"
