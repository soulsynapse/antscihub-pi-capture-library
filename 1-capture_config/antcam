seconds_to_duration_value() {
    local total_seconds="${1:-0}"
    if [[ ! "${total_seconds}" =~ ^[0-9]+$ ]]; then
        return 1
    fi

    local remaining="${total_seconds}"
    local hours=0 minutes=0 seconds=0 duration_value=""
    hours=$((remaining / 3600))
    remaining=$((remaining % 3600))
    minutes=$((remaining / 60))
    seconds=$((remaining % 60))

    if [[ "${hours}" -gt 0 ]]; then
        duration_value+="${hours}h"
    fi
    if [[ "${minutes}" -gt 0 ]]; then
        duration_value+="${minutes}m"
    fi
    if [[ "${seconds}" -gt 0 || -z "${duration_value}" ]]; then
        duration_value+="${seconds}s"
    fi

    printf '%s\n' "${duration_value}"
}

