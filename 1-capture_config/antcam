normalize_duration_value() {
    local input="${1:-}"
    input="${input//[[:space:]]/}"
    input="${input,,}"
    printf '%s\n' "${input}"
}

duration_to_milliseconds() {
    local duration_value
    duration_value="$(normalize_duration_value "${1:-}")"
    [[ -n "${duration_value}" ]] || return 1

    local remaining="${duration_value}"
    local total_ms=0
    local amount=0
    local unit=""
    local rest=""

    while [[ -n "${remaining}" ]]; do
        if [[ "${remaining}" =~ ^([0-9]+)([hms])(.*)$ ]]; then
            amount="${BASH_REMATCH[1]}"
            unit="${BASH_REMATCH[2]}"
            rest="${BASH_REMATCH[3]}"
        else
            return 1
        fi

        case "${unit}" in
            h)
                total_ms=$((total_ms + (amount * 3600000)))
                ;;
            m)
                total_ms=$((total_ms + (amount * 60000)))
                ;;
            s)
                total_ms=$((total_ms + (amount * 1000)))
                ;;
            *)
                return 1
                ;;
        esac
        remaining="${rest}"
    done

    printf '%s\n' "${total_ms}"
}

is_positive_numeric_value() {
    local value="$1"
    [[ "${value}" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
    awk -v v="${value}" 'BEGIN { exit (v > 0 ? 0 : 1) }'
}

is_valid_lens_position_value() {
    local value="$1"
    [[ "${value}" =~ ^[0-9]+([.][0-9]+)?$ ]]
}

is_auto_focus_value() {
    local value="${1:-}"
    [[ "${value,,}" == "auto" ]]
}

is_valid_focus_setting_value() {
    local value="${1:-}"
    is_auto_focus_value "${value}" || is_valid_lens_position_value "${value}"
}

is_valid_fps_value() {
    local value="$1"
    is_positive_numeric_value "${value}"
}

is_valid_duration_value() {
    local value="${1:-}"
    duration_to_milliseconds "${value}" >/dev/null 2>&1
}

normalize_loop_setting_value() {
    local raw_value="${1:-}"
    local normalized_value loop_ms
    normalized_value="$(normalize_duration_value "${raw_value}")"
    [[ -n "${normalized_value}" ]] || return 1

    if [[ "${normalized_value}" == "none" || "${normalized_value}" == "0" ]]; then
        printf '%s\n' "none"
        return 0
    fi

    is_valid_duration_value "${normalized_value}" || return 1
    loop_ms="$(duration_to_milliseconds "${normalized_value}" || true)"
    [[ -n "${loop_ms}" ]] || return 1
    if [[ "${loop_ms}" -le 0 ]]; then
        printf '%s\n' "none"
    else
        printf '%s\n' "${normalized_value}"
    fi
}

normalize_recording_name_value() {
