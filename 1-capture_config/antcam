    kill "-${signal_name}" "${pid}" >/dev/null 2>&1 || true

    if command -v pkill >/dev/null 2>&1; then
        pkill "-${signal_name}" -P "${pid}" >/dev/null 2>&1 || true
    fi

    return 0
}

sanitize_recording_script_name() {
    local script_name="$1"
    [[ "${script_name}" =~ ^[a-zA-Z0-9._-]+$ ]] || die "invalid recording script name: ${script_name}"
}

resolve_recording_script_path() {
    local requested_name="$1"
    sanitize_recording_script_name "${requested_name}"

    local self_dir repo_dir
    self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    repo_dir="${self_dir}/../3-recording_scripts"

    local search_dirs=()
    if [[ -d "${RECORDING_SCRIPT_DIR}" ]]; then
        search_dirs+=("${RECORDING_SCRIPT_DIR}")
    fi
    if [[ -d "${repo_dir}" && "${repo_dir}" != "${RECORDING_SCRIPT_DIR}" ]]; then
        search_dirs+=("${repo_dir}")
    fi
    (( ${#search_dirs[@]} > 0 )) || die "recording script directories not found: ${RECORDING_SCRIPT_DIR}, ${repo_dir}"

    local script_dir direct_path python_path shell_path
    for script_dir in "${search_dirs[@]}"; do
        direct_path="${script_dir}/${requested_name}"
        python_path="${script_dir}/${requested_name}.py"
        shell_path="${script_dir}/${requested_name}.sh"
        if [[ -f "${direct_path}" ]]; then
            printf '%s\n' "${direct_path}"
            return 0
        fi
        if [[ -f "${python_path}" ]]; then
            printf '%s\n' "${python_path}"
            return 0
        fi
        if [[ -f "${shell_path}" ]]; then
            printf '%s\n' "${shell_path}"
            return 0
        fi
    done

    die "recording script not found: ${requested_name} (searched ${RECORDING_SCRIPT_DIR} and ${repo_dir})"
}

json_escape() {
    local input="${1:-}"
    input="${input//\\/\\\\}"
    input="${input//\"/\\\"}"
    input="${input//$'\n'/\\n}"
    input="${input//$'\r'/\\r}"
    input="${input//$'\t'/\\t}"
    printf '%s' "${input}"
}

normalize_device_id() {
    local input="${1:-}"
    input="${input//$'\r'/}"
    input="${input//$'\n'/}"
    input="${input//$'\t'/}"
    input="${input// /}"
    printf '%s' "${input}"
}

detect_device_id_fallback() {
    local raw=""
    raw="$(hostname 2>/dev/null || true)"
    if [[ -z "$raw" && -f /etc/hostname ]]; then
        raw="$(head -n 1 /etc/hostname 2>/dev/null || true)"
    fi
    if [[ -z "$raw" && -f /etc/machine-id ]]; then
        raw="$(head -n 1 /etc/machine-id 2>/dev/null || true)"
    fi
    raw="${raw//[^[:alnum:]._-]/_}"
    raw="${raw//__/_}"
    raw="${raw##_}"
    raw="${raw%%_}"
    if [[ -z "$raw" ]]; then
        raw="unknown-device"
    fi
    printf '%s' "$raw"
}

resolve_device_id() {
    if [[ "${DEVICE_ID_CACHE_READY}" == "true" ]]; then
        printf '%s' "${DEVICE_ID_CACHE}"
        return 0
    fi

    local candidate=""
    if [[ -n "${DEVICE_ID:-}" ]]; then
        candidate="$(normalize_device_id "${DEVICE_ID}")"
    elif [[ -n "${FLEET_DEVICE_ID:-}" ]]; then
        candidate="$(normalize_device_id "${FLEET_DEVICE_ID}")"
    fi

    if [[ -z "${candidate}" ]] && command -v "${FLEET_PUBLISH_BIN}" >/dev/null 2>&1; then
        candidate="$("${FLEET_PUBLISH_BIN}" --device-id 2>/dev/null | head -n 1 || true)"
        candidate="$(normalize_device_id "${candidate}")"
        if [[ "${candidate}" == *=* ]]; then
            candidate="${candidate##*=}"
            candidate="$(normalize_device_id "${candidate}")"
        fi
        if [[ -z "${candidate}" ]]; then
            candidate="$("${FLEET_PUBLISH_BIN}" device-id 2>/dev/null | head -n 1 || true)"
            candidate="$(normalize_device_id "${candidate}")"
            if [[ "${candidate}" == *=* ]]; then
                candidate="${candidate##*=}"
                candidate="$(normalize_device_id "${candidate}")"
            fi
        fi
    fi

    if [[ -z "${candidate}" ]] && command -v python3 >/dev/null 2>&1; then
        candidate="$(python3 - <<'PY' 2>/dev/null || true
try:
    from mqtt_client import DEVICE_ID
    print((DEVICE_ID or "").strip())
except Exception:
    pass
PY
)"
        candidate="$(normalize_device_id "${candidate}")"
    fi

    if [[ -z "${candidate}" ]]; then
        local file_candidate
        for file_candidate in \
            "/etc/fleet/device_id" \
            "/var/lib/fleet/device_id" \
            "${XDG_CONFIG_HOME:-${HOME}/.config}/fleet/device_id" \
            "/etc/antscihub/device_id"; do
            if [[ -f "${file_candidate}" ]]; then
                candidate="$(head -n 1 "${file_candidate}" 2>/dev/null || true)"
                candidate="$(normalize_device_id "${candidate}")"
                [[ -n "${candidate}" ]] && break
            fi
        done
    fi

    if [[ -z "${candidate}" ]]; then
        candidate="$(detect_device_id_fallback)"
    fi

    DEVICE_ID_CACHE="${candidate}"
    DEVICE_ID_CACHE_READY="true"
    printf '%s' "${DEVICE_ID_CACHE}"
}

build_fleet_event_topic() {
    local device_id="$1"
    local template="${FLEET_EVENT_TOPIC_TEMPLATE}"
    local topic

    topic="${template//\{DEVICE_ID\}/${device_id}}"
    if [[ -z "${topic}" ]]; then
        topic="fleet/report/${device_id}"
    fi

    printf '%s' "${topic}"
}

publish_with_fleet_publish() {
    local topic="$1"
    local payload="$2"

    command -v "${FLEET_PUBLISH_BIN}" >/dev/null 2>&1 || return 1

    "${FLEET_PUBLISH_BIN}" --topic "${topic}" --json "${payload}" >/dev/null 2>&1 && return 0
    "${FLEET_PUBLISH_BIN}" --topic "${topic}" --payload "${payload}" >/dev/null 2>&1 && return 0
    "${FLEET_PUBLISH_BIN}" --topic "${topic}" --message "${payload}" >/dev/null 2>&1 && return 0
    "${FLEET_PUBLISH_BIN}" -t "${topic}" -m "${payload}" >/dev/null 2>&1 && return 0

    return 1
}

publish_with_mqtt_report_cli() {
    local topic="$1"
    local payload="$2"

    command -v "${MQTT_REPORT_BIN}" >/dev/null 2>&1 || return 1
    "${MQTT_REPORT_BIN}" --topic "${topic}" --json "${payload}" >/dev/null 2>&1
}

publish_with_fleet_mqtt_python() {
    local topic="$1"
    local payload="$2"

    command -v python3 >/dev/null 2>&1 || return 1

    python3 - "${topic}" "${payload}" >/dev/null 2>&1 <<'PY'
import json
import sys

topic = sys.argv[1]
payload_raw = sys.argv[2]

try:
    payload_obj = json.loads(payload_raw)
except Exception:
    payload_obj = payload_raw

published = False

try:
    from mqtt_client import fleet
    try:
        if hasattr(fleet, "loop_start"):
            fleet.loop_start()
        if hasattr(fleet, "wait_until_connected"):
            fleet.wait_until_connected(timeout=10)
    except Exception:
        pass
    try:
        fleet.publish(topic, payload_obj, encrypt=True)
    except TypeError:
        fleet.publish(topic, payload_obj)
    published = True
except Exception:
    published = False

if not published:
    try:
        from mqtt_client import FleetMQTT
    except Exception:
        sys.exit(2)

    client = None
    for ctor in (lambda: FleetMQTT(), lambda: FleetMQTT("antscihub-recording")):
        try:
            client = ctor()
            break
        except Exception:
            continue

    if client is None:
        sys.exit(3)

    for method_name in ("publish_json", "publish", "send"):
        method = getattr(client, method_name, None)
        if not callable(method):
            continue
        try:
            if method_name == "publish_json":
                if isinstance(payload_obj, str):
                    parsed_payload = json.loads(payload_obj)
                else:
                    parsed_payload = payload_obj
                try:
                    method(topic, parsed_payload, encrypt=True)
                except TypeError:
                    method(topic, parsed_payload)
            else:
                try:
                    method(topic, payload_obj, encrypt=True)
                except TypeError:
                    try:
                        method(topic, payload_obj)
                    except TypeError:
                        method(topic, payload_raw)
            published = True
            break
        except Exception:
            continue

    for close_name in ("close", "disconnect", "stop"):
        close_method = getattr(client, close_name, None)
        if callable(close_method):
            try:
                close_method()
            except Exception:
                pass

sys.exit(0 if published else 4)
PY
}

publish_recording_event() {
    local report_name="$1"
    local severity="$2"
    local message="$3"
    local success_bool="$4"
    local capture_dir="${5:-}"
    local script_path="${6:-}"
    local exit_code="${7:-}"

    if [[ "${MQTT_EVENT_ENABLED,,}" != "true" ]]; then
        return 0
    fi

    local device_id topic timestamp payload
    resolve_device_id >/dev/null
    device_id="${DEVICE_ID_CACHE}"
    topic="$(build_fleet_event_topic "${device_id}")"
    timestamp="$(date +%s)"

    payload="{\"event\":\"report\""
    payload+=",\"report\":\"$(json_escape "${report_name}")\""
    payload+=",\"device_id\":\"$(json_escape "${device_id}")\""
    payload+=",\"timestamp\":${timestamp}"
    payload+=",\"severity\":\"$(json_escape "${severity}")\""
    payload+=",\"message\":\"$(json_escape "${message}")\""
    payload+=",\"success\":${success_bool}"
    payload+=",\"service\":\"antscihub-recording\""
    if [[ -n "${capture_dir}" ]]; then
        payload+=",\"folder\":\"$(json_escape "${capture_dir}")\""
    fi
    if [[ -n "${script_path}" ]]; then
        payload+=",\"script\":\"$(json_escape "${script_path}")\""
    fi
    if [[ -n "${exit_code}" ]]; then
        payload+=",\"exit_code\":\"$(json_escape "${exit_code}")\""
    fi
    payload+="}"

    if publish_with_fleet_publish "${topic}" "${payload}"; then
        return 0
    fi
    if publish_with_mqtt_report_cli "${topic}" "${payload}"; then
        return 0
    fi
    if publish_with_fleet_mqtt_python "${topic}" "${payload}"; then
        return 0
    fi

    if [[ "${MQTT_PUBLISH_WARNING_EMITTED}" != "true" ]]; then
        echo "antcam: warning: unable to publish recording MQTT events (tried ${FLEET_PUBLISH_BIN}, ${MQTT_REPORT_BIN}, python mqtt_client)" >&2
        MQTT_PUBLISH_WARNING_EMITTED="true"
    fi
    return 1
}

write_script_failure_diagnostic() {
    local user_home="$1"
    local capture_dir="$2"
    local script_path="$3"
    local exit_code="$4"
    local console_log_path="$5"
    local script_kind="$6"

    local upload_dir timestamp_utc timestamp_slug device_id
    local target_subdir primary_dir primary_file fallback_dir fallback_file
    local diagnostic_body_tmp
    upload_dir="$(resolve_upload_dir_for_home "${user_home}")"

    timestamp_utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    timestamp_slug="$(date -u +%Y%m%dT%H%M%SZ)"
    resolve_device_id >/dev/null
    device_id="${DEVICE_ID_CACHE}"
    target_subdir="diagnostics/recordings"

    primary_dir="${upload_dir}/${target_subdir}"
    primary_file="${primary_dir}/${script_kind}-failure-${device_id}-${timestamp_slug}.log"
    fallback_dir="${upload_dir}/diagnostics"
    fallback_file="${fallback_dir}/diagnostic-write-fallback-${device_id}-${timestamp_slug}.log"
    diagnostic_body_tmp="$(mktemp)"

    {
        echo "# AntCam Script Failure Diagnostic"
        echo "timestamp_utc=${timestamp_utc}"
        echo "device_id=${device_id}"
        echo "script_kind=${script_kind}"
        echo "capture_dir=${capture_dir}"
        echo "script_path=${script_path}"
        echo "exit_code=${exit_code}"
        echo
        echo "## Console Output"
        if [[ -f "${console_log_path}" ]]; then
            cat "${console_log_path}"
        else
            echo "(console log file unavailable)"
        fi
    } > "${diagnostic_body_tmp}"

    if mkdir -p "${primary_dir}" && cp "${diagnostic_body_tmp}" "${primary_file}" >/dev/null 2>&1; then
        rm -f "${diagnostic_body_tmp}" >/dev/null 2>&1 || true
        echo "wrote script failure diagnostic: ${primary_file}"
        return 0
    fi

    if mkdir -p "${fallback_dir}"; then
        {
            echo "# AntCam Diagnostic Write Fallback"
            echo "timestamp_utc=${timestamp_utc}"
            echo "device_id=${device_id}"
            echo "script_kind=${script_kind}"
            echo "intended_path=${primary_file}"
            echo "reason=failed_to_write_primary_diagnostic"
            echo
            echo "## Original Diagnostic Content"
            cat "${diagnostic_body_tmp}"
        } > "${fallback_file}"
        rm -f "${diagnostic_body_tmp}" >/dev/null 2>&1 || true
        echo "wrote fallback diagnostic: ${fallback_file}"
        return 0
    fi

    rm -f "${diagnostic_body_tmp}" >/dev/null 2>&1 || true
    echo "antcam: warning: unable to write diagnostic report to ${primary_dir} or fallback diagnostics folder" >&2
    return 1
}

normalize_lines() {
    awk '
        {
            sub(/\r$/, "", $0)
        }
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        {
            gsub(/[[:space:]]+$/, "", $0)
            print
        }
    '
}

render_profile_block() {
    local profile="$1"
    local path
    path="$(profile_path "${profile}")"
    normalize_lines < "${path}"
}

get_current_managed_block() {
    local config_file="$1"
    awk -v begin="${BEGIN_MARKER}" -v end="${END_MARKER}" '
        $0 == begin { in_block = 1; next }
        $0 == end { in_block = 0; next }
        in_block { print }
    ' "${config_file}" | normalize_lines
}

list_profiles() {
    require_profile_dir
    local file name desc
    shopt -s nullglob
    local files=("${PROFILE_DIR}"/*.conf)
    shopt -u nullglob

    if (( ${#files[@]} == 0 )); then
        die "no profiles found in ${PROFILE_DIR}"
    fi

    for file in "${files[@]}"; do
        name="$(basename "${file}" .conf)"
        desc="$(awk '/^[[:space:]]*#/ { sub(/^[[:space:]]*#[[:space:]]*/, "", $0); print; exit }' "${file}")"
        if [[ -n "${desc}" ]]; then
            printf '%s - %s\n' "${name}" "${desc}"
        else
            printf '%s\n' "${name}"
        fi
    done | sort
}

current_profile_name() {
    require_profile_dir
    local config_file
    config_file="$(resolve_config_file)" || die "could not locate Raspberry Pi config.txt"

    local current_block
    current_block="$(get_current_managed_block "${config_file}")"
    if [[ -z "${current_block//[[:space:]]/}" ]]; then
        echo "unmanaged"
        return 0
    fi

    local file name profile_block
    shopt -s nullglob
    local files=("${PROFILE_DIR}"/*.conf)
    shopt -u nullglob

    for file in "${files[@]}"; do
        name="$(basename "${file}" .conf)"
        profile_block="$(render_profile_block "${name}")"
        if [[ "${current_block}" == "${profile_block}" ]]; then
            echo "${name}"
            return 0
        fi
    done

    echo "custom-managed"
}

