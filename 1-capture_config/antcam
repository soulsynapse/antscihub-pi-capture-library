start_recording() {
    local requested_script_name="$1"
    local user_home
    user_home="$(resolve_effective_home)" || die "could not resolve user home for recording path"
    local effective_user
    effective_user="$(resolve_effective_user || true)"
    [[ -n "${effective_user}" ]] || effective_user="$(id -un)"

    local capture_dir upload_dir record_script focus_value focus_file
    local fps_value fps_file length_value length_file segment_value segment_file intra_value intra_file
    local photo_every_value photo_every_file name_value name_file script_basename photos_one_shot_guard
    local length_source photo_every_source name_source strict_service_context
    local recording_last_start_state_file last_start_context_payload
    local recording_state_file existing_record_pid
    local recording_resume_state_file
    local length_ms recording_start_epoch recording_end_epoch
    local resume_enabled resume_window_source
    local override_start_epoch override_end_epoch
    capture_dir="$(resolve_capture_dir_for_home "${user_home}")"
    upload_dir="$(resolve_upload_dir_for_home "${user_home}")"
    recording_state_file="$(resolve_recording_state_file_for_home "${user_home}")"
    recording_last_start_state_file="$(resolve_recording_last_start_state_file_for_home "${user_home}")"
    recording_resume_state_file="$(resolve_recording_resume_state_file_for_home "${user_home}")"
    record_script="$(resolve_recording_script_path "${requested_script_name}")"
    script_basename="$(basename "${record_script}")"
    focus_value="$(read_focus_setting_for_home "${user_home}")"
    focus_file="$(resolve_focus_value_file_for_home "${user_home}")"
    fps_value="$(read_fps_setting_for_home "${user_home}")"
    fps_file="$(resolve_fps_value_file_for_home "${user_home}")"
    length_file="$(resolve_length_value_file_for_home "${user_home}")"
    photo_every_file="$(resolve_photo_every_value_file_for_home "${user_home}")"
    if [[ -f "${length_file}" ]]; then
        length_source="file"
    else
        length_source="default"
    fi
    if [[ -f "${photo_every_file}" ]]; then
        photo_every_source="file"
    else
        photo_every_source="default"
    fi
    name_file="$(resolve_name_value_file_for_home "${user_home}")"
    if [[ -f "${name_file}" ]]; then
        name_source="file"
    else
        name_source="default"
    fi
    length_value="$(read_length_setting_for_home "${user_home}")"
    photo_every_value="$(read_photo_every_setting_for_home "${user_home}")"
    name_value="$(read_name_setting_for_home "${user_home}")"
    strict_service_context="false"
    if is_service_execution_context; then
        strict_service_context="true"
    fi
    segment_file="$(resolve_segment_value_file_for_home "${user_home}")"
    intra_file="$(resolve_intra_value_file_for_home "${user_home}")"
    if [[ "${script_basename}" == "video.py" || "${script_basename}" == "video.sh" || "${script_basename}" == "video" ]]; then
        segment_value="$(read_segment_setting_for_home "${user_home}")"
        intra_value="$(read_intra_setting_for_home "${user_home}")"
    else
        segment_value=""
        intra_value=""
    fi
    photos_one_shot_guard="false"
    if [[ "${script_basename}" == "photos.py" || "${script_basename}" == "photos.sh" || "${script_basename}" == "photos" ]]; then
        if [[ "${strict_service_context}" == "true" && "${photo_every_source}" == "default" ]]; then
            die "photos start refused in service context: photo-every settings file missing at ${photo_every_file}. set photo-every explicitly first (for example: antcam photo-every set none)"
        fi

        if [[ "${photo_every_value}" == "none" ]]; then
            # Compatibility guard: force one-shot for photos when photo-every is disabled,
            # including older deployed photos.sh variants.
            length_value="0s"
            photos_one_shot_guard="true"
        fi
    fi

    length_ms="$(duration_to_milliseconds "${length_value}" || true)"
    [[ -n "${length_ms}" ]] || die "invalid recording length value: ${length_value}"

    resume_enabled="false"
    resume_window_source="computed_from_length"
    recording_start_epoch="$(date +%s)"
    recording_end_epoch="${recording_start_epoch}"

    if [[ "${length_ms}" -gt 0 ]]; then
        local length_seconds
        length_seconds=$((length_ms / 1000))
        recording_end_epoch=$((recording_start_epoch + length_seconds))
        if [[ $((length_ms % 1000)) -gt 0 ]]; then
            recording_end_epoch=$((recording_end_epoch + 1))
        fi
        resume_enabled="true"
    fi

    override_start_epoch="${ANTCAM_RECORDING_RESUME_ORIGINAL_START_EPOCH:-}"
    override_end_epoch="${ANTCAM_RECORDING_RESUME_WINDOW_END_EPOCH:-}"
    if [[ -n "${override_start_epoch}" || -n "${override_end_epoch}" ]]; then
        [[ "${override_start_epoch}" =~ ^[0-9]+$ ]] || die "invalid resume start epoch override: ${override_start_epoch}"
        [[ "${override_end_epoch}" =~ ^[0-9]+$ ]] || die "invalid resume end epoch override: ${override_end_epoch}"
        [[ "${override_end_epoch}" -gt "${override_start_epoch}" ]] || die "invalid resume window override: end must be after start"
        recording_start_epoch="${override_start_epoch}"
        recording_end_epoch="${override_end_epoch}"
        resume_enabled="true"
        resume_window_source="resume_override"
    fi

    last_start_context_payload="$(
        cat <<EOF
timestamp_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
effective_user=${effective_user}
effective_home=${user_home}
invoking_user=$(id -un)
invoking_uid=$(id -u)
service_context=${strict_service_context}
invocation_id=${INVOCATION_ID:-}
requested_script_name=${requested_script_name}
resolved_script_path=${record_script}
resolved_script_basename=${script_basename}
capture_dir=${capture_dir}
upload_dir=${upload_dir}
focus_file=${focus_file}
focus_value=${focus_value}
fps_file=${fps_file}
fps_value=${fps_value}
length_file=${length_file}
length_value=${length_value}
length_source=${length_source}
segment_file=${segment_file}
segment_value=${segment_value}
intra_file=${intra_file}
intra_value=${intra_value}
photo_every_file=${photo_every_file}
photo_every_value=${photo_every_value}
photo_every_source=${photo_every_source}
name_file=${name_file}
name_value=${name_value}
name_source=${name_source}
photos_one_shot_guard=${photos_one_shot_guard}
recording_state_file=${recording_state_file}
recording_resume_state_file=${recording_resume_state_file}
recording_resume_enabled=${resume_enabled}
recording_resume_start_epoch=${recording_start_epoch}
recording_resume_end_epoch=${recording_end_epoch}
recording_resume_window_source=${resume_window_source}
EOF
    )"
    write_recording_last_start_context_for_home "${user_home}" "${last_start_context_payload}" >/dev/null 2>&1 || true

    if [[ -f "${recording_state_file}" ]]; then
        existing_record_pid="$(read_recording_pid_from_state_file "${recording_state_file}" || true)"
        if [[ -n "${existing_record_pid}" ]] && is_pid_running "${existing_record_pid}"; then
            die "a recording is already running (pid ${existing_record_pid}); use 'antcam stop' first"
        fi
        rm -f "${recording_state_file}" >/dev/null 2>&1 || true
    fi

    if [[ ! -d "${capture_dir}" ]]; then
        mkdir -p "${capture_dir}"
        echo "created capture directory: ${capture_dir}"
    fi

    [[ -f "${record_script}" ]] || die "recording script path is not a file: ${record_script}"
    chmod +x "${record_script}" >/dev/null 2>&1 || true

    echo "capture directory: ${capture_dir}"
    echo "effective user/home: ${effective_user} / ${user_home}"
    echo "recording script: ${record_script}"
    echo "focus lens-position: ${focus_value}"
    echo "recording fps: ${fps_value}"
    echo "recording length: ${length_value}"
    echo "recording length source: ${length_source}"
    if [[ "${photos_one_shot_guard}" == "true" ]]; then
        echo "photos one-shot guard: enabled (photo-every=none forces length=0s)"
    fi
    echo "recording photo-every: ${photo_every_value}"
    echo "recording photo-every source: ${photo_every_source}"
    echo "recording name: ${name_value}"
    echo "recording name source: ${name_source}"
    echo "service context: ${strict_service_context}"
    if [[ -n "${segment_value}" ]]; then
        echo "recording segment: ${segment_value}"
    else
        echo "recording segment: (unused by ${script_basename})"
    fi
    if [[ -n "${intra_value}" ]]; then
        echo "recording intra: ${intra_value}"
    else
        echo "recording intra: (unused by ${script_basename})"
    fi
    echo "recording upload dir: ${upload_dir}"
    echo "recording state file: ${recording_state_file}"
    echo "recording last-start context file: ${recording_last_start_state_file}"
    echo "recording resume state file: ${recording_resume_state_file}"
    if [[ "${resume_enabled}" == "true" ]]; then
        echo "recording resume window: start_epoch=${recording_start_epoch} end_epoch=${recording_end_epoch} source=${resume_window_source}"
    else
        echo "recording resume window: disabled (length <= 0s)"
    fi

    publish_recording_event \
        "recording_start" \
        "ATTENTION" \
        "Recording script starting" \
        "true" \
        "${capture_dir}" \
        "${record_script}" || true

    local record_exit_code=0
    local record_console_log record_pid stop_requested
    stop_requested="false"
    record_console_log="$(mktemp)"

    set +e
    (
        cd "${capture_dir}"
        exec env \
            ANTCAM_CAPTURE_DIR="${capture_dir}" \
            ANTCAM_UPLOAD_DIR="${upload_dir}" \
            ANTCAM_FOCUS_VALUE_FILE="${focus_file}" \
            ANTCAM_FOCUS_LENS_POSITION="${focus_value}" \
            ANTCAM_FPS_VALUE_FILE="${fps_file}" \
            ANTCAM_RECORDING_FPS="${fps_value}" \
            ANTCAM_LENGTH_VALUE_FILE="${length_file}" \
            ANTCAM_RECORDING_LENGTH="${length_value}" \
            ANTCAM_PHOTO_EVERY_VALUE_FILE="${photo_every_file}" \
            ANTCAM_RECORDING_PHOTO_EVERY="${photo_every_value}" \
            ANTCAM_NAME_VALUE_FILE="${name_file}" \
            ANTCAM_RECORDING_NAME="${name_value}" \
            ANTCAM_SEGMENT_VALUE_FILE="${segment_file}" \
            ANTCAM_RECORDING_SEGMENT="${segment_value}" \
            ANTCAM_INTRA_VALUE_FILE="${intra_file}" \
            ANTCAM_RECORDING_INTRA="${intra_value}" \
            ANTCAM_RECORDING_START_EPOCH_MS="${ANTCAM_RECORDING_START_EPOCH_MS:-}" \
            "${record_script}"
    ) >> "${record_console_log}" 2>&1 &
    record_pid="$!"

    if ! write_recording_state_for_home "${user_home}" "${record_pid}" "${capture_dir}" "${record_script}" "${requested_script_name}"; then
        echo "antcam: warning: failed to write recording state file; stopping recording process ${record_pid}" >&2
        kill -INT "${record_pid}" >/dev/null 2>&1 || true
        wait "${record_pid}" >/dev/null 2>&1 || true
        set -e
        rm -f "${record_console_log}" >/dev/null 2>&1 || true
        die "unable to write recording state file: ${recording_state_file}"
    fi

    if [[ "${resume_enabled}" == "true" ]]; then
        if ! write_recording_resume_state_for_home \
            "${user_home}" \
            "${requested_script_name}" \
            "${record_script}" \
            "${capture_dir}" \
            "${upload_dir}" \
            "${focus_value}" \
            "${fps_value}" \
            "${length_value}" \
            "${segment_value}" \
            "${photo_every_value}" \
            "${name_value}" \
            "${recording_start_epoch}" \
            "${recording_end_epoch}" \
            "${resume_window_source}" \
            "${intra_value}"; then
            echo "antcam: warning: failed to write recording resume state file: ${recording_resume_state_file}" >&2
        fi
    else
        clear_recording_resume_state_for_home "${user_home}"
    fi

    wait "${record_pid}"
    record_exit_code="$?"
    stop_requested="$(read_recording_state_field "${recording_state_file}" "stop_requested" || true)"
    clear_recording_state_for_home "${user_home}"
    set -e

    if [[ "${record_exit_code}" -eq 0 ]]; then
        clear_recording_resume_state_for_home "${user_home}"
        publish_recording_event \
            "recording_end" \
            "INFO" \
            "Recording script completed" \
            "true" \
            "${capture_dir}" \
            "${record_script}" \
            "${record_exit_code}" || true
    elif [[ "${stop_requested}" == "true" ]]; then
        clear_recording_resume_state_for_home "${user_home}"
        publish_recording_event \
            "recording_end" \
            "INFO" \
            "Recording stopped by antcam stop" \
            "true" \
            "${capture_dir}" \
            "${record_script}" \
            "${record_exit_code}" || true
        record_exit_code=0
    else
        local now_epoch_after_failure failure_tail failure_reason_code failure_reason_detail diagnostic_file_path
        now_epoch_after_failure="$(date +%s)"
        if [[ "${resume_enabled}" == "true" && "${now_epoch_after_failure}" -ge "${recording_end_epoch}" ]]; then
            clear_recording_resume_state_for_home "${user_home}"
        fi
        failure_tail="$(tail_file_for_event "${record_console_log}" 30)"
        failure_reason_code="$(classify_script_failure_reason_code "recording" "${record_script}" "${record_exit_code}" "${failure_tail}")"
        failure_reason_detail="$(build_script_failure_reason_detail "recording" "${capture_dir}" "${record_script}" "${record_exit_code}" "${record_console_log}" "")"
        write_script_failure_diagnostic \
            "${user_home}" \
            "${capture_dir}" \
            "${record_script}" \
            "${record_exit_code}" \
            "${record_console_log}" \
            "recording" \
            "${failure_reason_code}" \
            "${failure_reason_detail}" || true
        diagnostic_file_path="${SCRIPT_FAILURE_DIAGNOSTIC_PATH}"
        failure_reason_detail="$(build_script_failure_reason_detail "recording" "${capture_dir}" "${record_script}" "${record_exit_code}" "${record_console_log}" "${diagnostic_file_path}")"
        publish_recording_event \
            "recording_end" \
            "ERROR" \
            "Recording script failed" \
            "false" \
            "${capture_dir}" \
            "${record_script}" \
            "${record_exit_code}" \
            "${failure_reason_code}" \
            "${failure_reason_detail}" \
            "${diagnostic_file_path}" || true
    fi

    rm -f "${record_console_log}" >/dev/null 2>&1 || true

    return "${record_exit_code}"
}

stop_recording() {
    local user_home
    user_home="$(resolve_effective_home)" || die "could not resolve user home for recording path"

    local recording_state_file record_pid capture_dir record_script record_script_name
    recording_state_file="$(resolve_recording_state_file_for_home "${user_home}")"

    if [[ ! -f "${recording_state_file}" ]]; then
        clear_recording_resume_state_for_home "${user_home}"
        echo "no active recording found"
        return 0
    fi

    record_pid="$(read_recording_pid_from_state_file "${recording_state_file}" || true)"
    capture_dir="$(read_recording_state_field "${recording_state_file}" "capture_dir" || true)"
    record_script="$(read_recording_state_field "${recording_state_file}" "record_script" || true)"
    record_script_name="$(read_recording_state_field "${recording_state_file}" "record_script_name" || true)"

    if [[ -z "${record_pid}" ]]; then
        rm -f "${recording_state_file}" >/dev/null 2>&1 || true
        clear_recording_resume_state_for_home "${user_home}"
        echo "removed stale recording state file with missing pid: ${recording_state_file}"
        return 0
    fi

    if ! is_pid_running "${record_pid}"; then
        rm -f "${recording_state_file}" >/dev/null 2>&1 || true
        clear_recording_resume_state_for_home "${user_home}"
        echo "removed stale recording state file (pid not running): ${recording_state_file}"
        return 0
    fi

    mark_recording_stop_requested_for_home "${user_home}" || true

    if [[ -n "${record_script_name}" ]]; then
        echo "stopping recording script '${record_script_name}' (pid ${record_pid}) with SIGINT"
    else
        echo "stopping recording process ${record_pid} with SIGINT"
    fi
    signal_pid_and_children "INT" "${record_pid}" || die "failed to signal recording process ${record_pid}"

    local wait_seconds=0
    while is_pid_running "${record_pid}" && [[ "${wait_seconds}" -lt "${DEFAULT_RECORDING_STOP_TIMEOUT_SECONDS}" ]]; do
        sleep 1
        wait_seconds=$((wait_seconds + 1))
    done

    if is_pid_running "${record_pid}"; then
        echo "recording process ${record_pid} is still running after ${DEFAULT_RECORDING_STOP_TIMEOUT_SECONDS}s; sending SIGTERM"
        signal_pid_and_children "TERM" "${record_pid}" || true

        wait_seconds=0
        while is_pid_running "${record_pid}" && [[ "${wait_seconds}" -lt "${DEFAULT_RECORDING_STOP_TERM_TIMEOUT_SECONDS}" ]]; do
            sleep 1
            wait_seconds=$((wait_seconds + 1))
        done
    fi

    if is_pid_running "${record_pid}"; then
        die "recording process ${record_pid} did not stop after SIGINT/SIGTERM"
    fi

    clear_recording_state_for_home "${user_home}"
    clear_recording_resume_state_for_home "${user_home}"

    publish_recording_event \
        "recording_stop" \
        "INFO" \
        "Recording stop requested by antcam stop" \
        "true" \
        "${capture_dir}" \
        "${record_script}" || true

    echo "recording stopped"
}

resume_recording_if_needed() {
    local mode="${1:-manual}"
    local quiet="false"
    if [[ "${mode}" == "--service" ]]; then
        quiet="true"
    fi

    local user_home recording_state_file recording_resume_state_file
    user_home="$(resolve_effective_home)" || die "could not resolve user home for recording resume path"
    recording_state_file="$(resolve_recording_state_file_for_home "${user_home}")"
    recording_resume_state_file="$(resolve_recording_resume_state_file_for_home "${user_home}")"

    if [[ ! -f "${recording_resume_state_file}" ]]; then
        if [[ "${quiet}" != "true" ]]; then
            echo "no pending recording resume window"
        fi
        return 0
    fi

    local existing_record_pid
    if [[ -f "${recording_state_file}" ]]; then
        existing_record_pid="$(read_recording_pid_from_state_file "${recording_state_file}" || true)"
        if [[ -n "${existing_record_pid}" ]] && is_pid_running "${existing_record_pid}"; then
            if [[ "${quiet}" != "true" ]]; then
                echo "recording is already running (pid ${existing_record_pid}); resume skipped"
            fi
            return 0
        fi
        rm -f "${recording_state_file}" >/dev/null 2>&1 || true
    fi

    local resume_enabled requested_script_name record_script_saved
    local focus_value_saved fps_value_saved length_value_saved segment_value_saved intra_value_saved photo_every_value_saved name_value_saved
    local start_epoch_saved end_epoch_saved now_epoch remaining_seconds resume_length_value
    local record_script_path script_basename
    local resume_start_override resume_end_override photos_schedule_start_epoch_ms

    resume_enabled="$(read_recording_state_field "${recording_resume_state_file}" "resume_enabled" || true)"
    if [[ "${resume_enabled}" != "true" ]]; then
        clear_recording_resume_state_for_home "${user_home}"
        if [[ "${quiet}" != "true" ]]; then
            echo "resume state disabled; cleared stale resume file"
        fi
        return 0
    fi

    requested_script_name="$(read_recording_state_field "${recording_resume_state_file}" "requested_script_name" || true)"
    record_script_saved="$(read_recording_state_field "${recording_resume_state_file}" "record_script" || true)"
    focus_value_saved="$(read_recording_state_field "${recording_resume_state_file}" "focus_value" || true)"
    fps_value_saved="$(read_recording_state_field "${recording_resume_state_file}" "fps_value" || true)"
    length_value_saved="$(read_recording_state_field "${recording_resume_state_file}" "length_value" || true)"
    segment_value_saved="$(read_recording_state_field "${recording_resume_state_file}" "segment_value" || true)"
    intra_value_saved="$(read_recording_state_field "${recording_resume_state_file}" "intra_value" || true)"
    if [[ -z "${intra_value_saved}" ]]; then
        intra_value_saved="$(normalize_intra_setting_value "${DEFAULT_RECORDING_INTRA}" || true)"
        [[ -n "${intra_value_saved}" ]] || intra_value_saved="none"
    fi
    photo_every_value_saved="$(read_recording_state_field "${recording_resume_state_file}" "photo_every_value" || true)"
    name_value_saved="$(read_recording_state_field "${recording_resume_state_file}" "name_value" || true)"
    start_epoch_saved="$(read_recording_state_field "${recording_resume_state_file}" "recording_start_epoch" || true)"
    end_epoch_saved="$(read_recording_state_field "${recording_resume_state_file}" "recording_end_epoch" || true)"

    if [[ -z "${requested_script_name}" || ! "${start_epoch_saved}" =~ ^[0-9]+$ || ! "${end_epoch_saved}" =~ ^[0-9]+$ ]]; then
        clear_recording_resume_state_for_home "${user_home}"
        echo "invalid recording resume state file; cleared: ${recording_resume_state_file}" >&2
        return 1
    fi
    if [[ "${end_epoch_saved}" -le "${start_epoch_saved}" ]]; then
        clear_recording_resume_state_for_home "${user_home}"
        echo "invalid recording resume state file; cleared: ${recording_resume_state_file}" >&2
        return 1
    fi

    if [[ -n "${record_script_saved}" && -f "${record_script_saved}" ]]; then
        record_script_path="${record_script_saved}"
    else
        record_script_path="$(resolve_recording_script_path "${requested_script_name}")"
    fi
    script_basename="$(basename "${record_script_path}")"

    now_epoch="$(date +%s)"
    remaining_seconds=$((end_epoch_saved - now_epoch))
    if [[ "${remaining_seconds}" -le 0 ]]; then
        clear_recording_resume_state_for_home "${user_home}"
        if [[ "${quiet}" != "true" ]]; then
            echo "recording window ended; cleared resume state"
        fi
        return 0
    fi

    resume_start_override="${start_epoch_saved}"
    resume_end_override="${end_epoch_saved}"
    photos_schedule_start_epoch_ms=""

    if [[ "${script_basename}" == "photos.py" || "${script_basename}" == "photos.sh" || "${script_basename}" == "photos" ]]; then
        resume_length_value="${length_value_saved}"
        photos_schedule_start_epoch_ms="$((start_epoch_saved * 1000))"
    else
        resume_length_value="$(seconds_to_duration_value "${remaining_seconds}" || true)"
    fi
    if [[ -z "${resume_length_value}" ]]; then
        clear_recording_resume_state_for_home "${user_home}"
        echo "invalid resume length value computed for ${requested_script_name}; cleared resume state" >&2
        return 1
    fi

    local resume_tmp_dir
    resume_tmp_dir="$(mktemp -d /tmp/antcam-recording-resume.XXXXXX)"

    local resume_focus_file resume_fps_file resume_length_file resume_segment_file resume_intra_file resume_photo_every_file resume_name_file
    resume_focus_file="${resume_tmp_dir}/focus-lens-position.txt"
    resume_fps_file="${resume_tmp_dir}/recording-fps.txt"
    resume_length_file="${resume_tmp_dir}/recording-length.txt"
    resume_segment_file="${resume_tmp_dir}/recording-segment.txt"
    resume_intra_file="${resume_tmp_dir}/recording-intra.txt"
    resume_photo_every_file="${resume_tmp_dir}/recording-photo-every.txt"
    resume_name_file="${resume_tmp_dir}/recording-name.txt"

    printf '%s\n' "${focus_value_saved}" > "${resume_focus_file}"
    printf '%s\n' "${fps_value_saved}" > "${resume_fps_file}"
    printf '%s\n' "${resume_length_value}" > "${resume_length_file}"
    printf '%s\n' "${segment_value_saved}" > "${resume_segment_file}"
    printf '%s\n' "${intra_value_saved}" > "${resume_intra_file}"
    printf '%s\n' "${photo_every_value_saved}" > "${resume_photo_every_file}"
    printf '%s\n' "${name_value_saved}" > "${resume_name_file}"

    if [[ "${quiet}" != "true" ]]; then
        echo "resuming recording script '${requested_script_name}' with remaining window ${remaining_seconds}s"
        echo "resume window: start_epoch=${start_epoch_saved} end_epoch=${end_epoch_saved}"
    fi

    local start_rc
    start_rc=0
    set +e
    ANTCAM_FOCUS_VALUE_FILE="${resume_focus_file}" \
    ANTCAM_FPS_VALUE_FILE="${resume_fps_file}" \
    ANTCAM_LENGTH_VALUE_FILE="${resume_length_file}" \
    ANTCAM_SEGMENT_VALUE_FILE="${resume_segment_file}" \
    ANTCAM_INTRA_VALUE_FILE="${resume_intra_file}" \
    ANTCAM_PHOTO_EVERY_VALUE_FILE="${resume_photo_every_file}" \
    ANTCAM_NAME_VALUE_FILE="${resume_name_file}" \
    ANTCAM_RECORDING_RESUME_ORIGINAL_START_EPOCH="${resume_start_override}" \
    ANTCAM_RECORDING_RESUME_WINDOW_END_EPOCH="${resume_end_override}" \
    ANTCAM_RECORDING_START_EPOCH_MS="${photos_schedule_start_epoch_ms}" \
    start_recording "${requested_script_name}"
    start_rc="$?"
    set -e

    rm -rf "${resume_tmp_dir}" >/dev/null 2>&1 || true

    if [[ "${start_rc}" -ne 0 ]]; then
        local now_after_resume_attempt
        now_after_resume_attempt="$(date +%s)"
        if [[ "${now_after_resume_attempt}" -ge "${end_epoch_saved}" ]]; then
            clear_recording_resume_state_for_home "${user_home}"
        fi
    fi

    return "${start_rc}"
}

resolve_focus_script_path() {
    if [[ -n "${ANTCAM_FOCUS_SCRIPT:-}" && -f "${ANTCAM_FOCUS_SCRIPT}" ]]; then
        printf '%s\n' "${ANTCAM_FOCUS_SCRIPT}"
        return 0
    fi

    if [[ -f "/etc/antscihub/antcam_focus_autofocus.sh" ]]; then
        printf '%s\n' "/etc/antscihub/antcam_focus_autofocus.sh"
        return 0
    fi

    local script_dir repo_candidate
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    repo_candidate="${script_dir}/antcam_focus_autofocus.sh"
    if [[ -f "${repo_candidate}" ]]; then
        printf '%s\n' "${repo_candidate}"
        return 0
    fi

    return 1
}

extract_focus_lens_position() {
    local focus_log_path="$1"
    local candidate=""

    if [[ -f "${focus_log_path}" ]]; then
        candidate="$(tail -n 1 "${focus_log_path}" 2>/dev/null | tr -d '[:space:]' || true)"
        if [[ "${candidate}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
            printf '%s\n' "${candidate}"
            return 0
        fi

        candidate="$(grep -Eo 'lens-position[[:space:]]+[0-9]+([.][0-9]+)?' "${focus_log_path}" 2>/dev/null | tail -n 1 | awk '{print $2}' || true)"
        candidate="$(printf '%s' "${candidate}" | tr -d '[:space:]')"
        if [[ "${candidate}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    fi

    return 1
}

extract_focus_image_path() {
    local focus_log_path="$1"
    if [[ ! -f "${focus_log_path}" ]]; then
        return 1
    fi

    local image_path
    image_path="$(grep -E 'FOCUS_IMAGE_PATH=' "${focus_log_path}" 2>/dev/null | tail -n 1 | sed 's/^.*FOCUS_IMAGE_PATH=//')"
    image_path="$(printf '%s' "${image_path}" | tr -d '\r')"
    [[ -n "${image_path}" ]] || return 1
    printf '%s\n' "${image_path}"
}

format_lens_position_for_filename() {
    local lens_position="$1"

    if command -v python3 >/dev/null 2>&1; then
        python3 - "${lens_position}" <<'PY' 2>/dev/null || true
import sys
try:
    value = float(sys.argv[1])
except Exception:
    print("unknown")
    raise SystemExit(0)
print(f"{value:.1f}")
PY
        return 0
    fi

    if [[ "${lens_position}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        awk -v v="${lens_position}" 'BEGIN { printf "%.1f\n", v }'
    else
        printf '%s\n' "unknown"
    fi
}

resolve_focus_hostname_for_filename() {
    local host=""
    host="$(hostname 2>/dev/null || true)"
    if [[ -z "${host}" && -f /etc/hostname ]]; then
        host="$(head -n 1 /etc/hostname 2>/dev/null || true)"
    fi
    host="${host//$'\r'/}"
    host="${host//$'\n'/}"
    host="${host//$'\t'/}"
    host="${host//[^[:alnum:]._-]/_}"
    host="${host//__/_}"
    host="${host##_}"
    host="${host%%_}"
    [[ -n "${host}" ]] || host="unknown-host"
    printf '%s\n' "${host}"
}

drop_focus_photo_to_diagnostics() {
    local user_home="$1"
    local focus_image_path="$2"
    local lens_position="$3"

    [[ -f "${focus_image_path}" ]] || return 1

    local upload_dir diagnostics_dir timestamp_slug lens_tag host_tag destination
    upload_dir="$(resolve_upload_dir_for_home "${user_home}")"
    diagnostics_dir="${upload_dir}/diagnostics/recordings"
    timestamp_slug="$(date -u +%Y-%m-%d__T-%H-%M-%S)"
    lens_tag="$(format_lens_position_for_filename "${lens_position}")"
    host_tag="$(resolve_focus_hostname_for_filename)"
    destination="${diagnostics_dir}/${timestamp_slug}__focus-result-lens-position-${lens_tag}__${host_tag}.jpeg"

    mkdir -p "${diagnostics_dir}"
    cp -f "${focus_image_path}" "${destination}"
    printf '%s\n' "${destination}"
}

start_focus_check() {
    local user_home
    user_home="$(resolve_effective_home)" || die "could not resolve user home for focus path"

    local capture_dir focus_script
    capture_dir="$(resolve_capture_dir_for_home "${user_home}")"
    focus_script="$(resolve_focus_script_path)" || die "focus script not found (expected 1-capture_config/antcam_focus_autofocus.sh or /etc/antscihub/antcam_focus_autofocus.sh)"

    if [[ ! -d "${capture_dir}" ]]; then
        mkdir -p "${capture_dir}"
        echo "created capture directory: ${capture_dir}"
    fi

    [[ -f "${focus_script}" ]] || die "focus script path is not a file: ${focus_script}"
    chmod +x "${focus_script}" >/dev/null 2>&1 || true

    echo "capture directory: ${capture_dir}"
    echo "starting focus script: ${focus_script}"

    local focus_exit_code=0
    local focus_console_log
    local focus_lens_position=""
    local focus_image_path=""
    local dropped_photo_path=""
    focus_console_log="$(mktemp)"

    set +e
    (
        cd "${capture_dir}"
        bash "${focus_script}"
    ) 2>&1 | tee "${focus_console_log}"
    focus_exit_code="${PIPESTATUS[0]}"
    set -e

    focus_lens_position="$(extract_focus_lens_position "${focus_console_log}" || true)"
    focus_image_path="$(extract_focus_image_path "${focus_console_log}" || true)"

    if [[ "${focus_exit_code}" -eq 0 ]]; then
        if [[ -n "${focus_lens_position}" && -n "${focus_image_path}" ]]; then
            dropped_photo_path="$(drop_focus_photo_to_diagnostics "${user_home}" "${focus_image_path}" "${focus_lens_position}" || true)"
            if [[ -n "${dropped_photo_path}" ]]; then
                echo "focus diagnostic photo: ${dropped_photo_path}" >&2
            fi
        else
            echo "antcam: warning: autofocus output parsing incomplete; diagnostic photo naming with lens-position skipped" >&2
        fi
    else
        local focus_failure_tail focus_reason_code focus_reason_detail
        focus_failure_tail="$(tail_file_for_event "${focus_console_log}" 30)"
        focus_reason_code="$(classify_script_failure_reason_code "focus" "${focus_script}" "${focus_exit_code}" "${focus_failure_tail}")"
        focus_reason_detail="$(build_script_failure_reason_detail "focus" "${capture_dir}" "${focus_script}" "${focus_exit_code}" "${focus_console_log}" "")"
        write_script_failure_diagnostic \
            "${user_home}" \
            "${capture_dir}" \
            "${focus_script}" \
            "${focus_exit_code}" \
            "${focus_console_log}" \
            "focus" \
            "${focus_reason_code}" \
            "${focus_reason_detail}" || true
    fi

    rm -f "${focus_console_log}" >/dev/null 2>&1 || true
    return "${focus_exit_code}"
}

load_antcam_split_helpers() {
    local script_dir lib_dir candidate
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    for candidate in "${ANTCAM_LIB_DIR:-}" "${script_dir}" "/etc/antscihub/antcam-lib"; do
        [[ -n "${candidate}" ]] || continue
        if [[ -f "${candidate}/antcam_upload_helpers.sh" && -f "${candidate}/antcam_diagnostic_helpers.sh" ]]; then
            lib_dir="${candidate}"
            break
        fi
    done

    [[ -n "${lib_dir}" ]] || die "could not locate antcam helper libraries (antcam_upload_helpers.sh, antcam_diagnostic_helpers.sh)"

    # shellcheck source=/dev/null
    . "${lib_dir}/antcam_upload_helpers.sh"
    # shellcheck source=/dev/null
    . "${lib_dir}/antcam_diagnostic_helpers.sh"
}

main() {
    local cmd="${1:-}"
    case "${cmd}" in
        list)
            shift
            [[ $# -eq 0 ]] || die "list takes no arguments"
            list_profiles
            ;;
        show)
            shift
            [[ $# -eq 1 ]] || die "usage: antcam show <profile>"
            show_profile "$1"
            ;;
        apply)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam apply <profile> [--dry-run] [--no-reboot]"
            local profile="$1"
            shift
            apply_profile "${profile}" "$@"
            ;;
        start)
            shift
            [[ $# -eq 1 ]] || die "usage: antcam start <recording-script-name>"
            start_recording "$1"
            ;;
        stop)
            shift
            [[ $# -eq 0 ]] || die "usage: antcam stop"
            stop_recording
            ;;
        recording)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam recording resume-if-needed [--service]"
            case "$1" in
                resume-if-needed)
                    shift
                    if [[ $# -eq 0 ]]; then
                        resume_recording_if_needed "manual"
                    elif [[ $# -eq 1 && "$1" == "--service" ]]; then
                        resume_recording_if_needed "--service"
                    else
                        die "usage: antcam recording resume-if-needed [--service]"
                    fi
                    ;;
                *)
                    die "unknown recording action: $1"
                    ;;
            esac
            ;;
        capture)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam capture report"
            case "$1" in
                report)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam capture report"
                    report_capture_settings
                    ;;
                *)
                    die "unknown capture action: $1"
                    ;;
            esac
            ;;
        diagnostic)
            shift
            [[ $# -eq 0 ]] || die "usage: antcam diagnostic"
            report_diagnostic_payload
            ;;
        cam)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam cam report"
            case "$1" in
                report)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam cam report"
                    report_camera_make_model
                    ;;
                *)
                    die "unknown cam action: $1"
                    ;;
            esac
            ;;
        focus)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam focus <check|set|report> ..."
            case "$1" in
                check)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam focus check"
                    start_focus_check
                    ;;
                set)
                    shift
                    [[ $# -eq 1 ]] || die "usage: antcam focus set <lens-position|auto>"
                    set_focus_value "$1"
                    ;;
                report)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam focus report"
                    report_focus_value
                    ;;
                *)
                    die "unknown focus action: $1"
                    ;;
            esac
            ;;
        fps)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam fps <set|report> ..."
            case "$1" in
                set)
                    shift
                    [[ $# -eq 1 ]] || die "usage: antcam fps set <value>"
                    set_fps_value "$1"
                    ;;
                report)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam fps report"
                    report_fps_value
                    ;;
                *)
                    die "unknown fps action: $1"
                    ;;
            esac
            ;;
        length)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam length <set|report> ..."
            case "$1" in
                set)
                    shift
                    [[ $# -eq 1 ]] || die "usage: antcam length set <duration>"
                    set_length_value "$1"
                    ;;
                report)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam length report"
                    report_length_value
                    ;;
                *)
                    die "unknown length action: $1"
                    ;;
            esac
            ;;
        segment)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam segment <set|report> ..."
            case "$1" in
                set)
                    shift
                    [[ $# -eq 1 ]] || die "usage: antcam segment set <duration>"
                    set_segment_value "$1"
                    ;;
                report)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam segment report"
                    report_segment_value
                    ;;
                *)
                    die "unknown segment action: $1"
                    ;;
            esac
            ;;
        intra)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam intra <set|report> ..."
            case "$1" in
                set)
                    shift
                    [[ $# -eq 1 ]] || die "usage: antcam intra set <frames|none|0>"
                    set_intra_value "$1"
                    ;;
                report)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam intra report"
                    report_intra_value
                    ;;
                *)
                    die "unknown intra action: $1"
                    ;;
            esac
            ;;
        photo-every)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam photo-every <set|report> ..."
            case "$1" in
                set)
                    shift
                    [[ $# -eq 1 ]] || die "usage: antcam photo-every set <duration|none|0>"
                    set_photo_every_value "$1"
                    ;;
                report)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam photo-every report"
                    report_photo_every_value
                    ;;
                *)
                    die "unknown photo-every action: $1"
                    ;;
            esac
            ;;
        name)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam name <set|report> ..."
            case "$1" in
                set)
                    shift
                    [[ $# -eq 1 ]] || die "usage: antcam name set <name>"
                    set_name_value "$1"
                    ;;
                report)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam name report"
                    report_name_value
                    ;;
                *)
                    die "unknown name action: $1"
                    ;;
            esac
            ;;
        upload)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam upload <set|report|test|pause|resume|reload|prune> ..."
            case "$1" in
                set)
                    shift
                    [[ $# -ge 2 ]] || die "usage: antcam upload set <profile|retention|local-target|remote|remote-path|watermark-high|watermark-low> <value>"
                    case "$1" in
                        profile)
                            shift
                            [[ $# -eq 1 ]] || die "usage: antcam upload set profile <field|cloud|local>"
                            set_upload_profile_value "$1"
                            ;;
                        retention)
                            shift
                            [[ $# -eq 1 ]] || die "usage: antcam upload set retention <protect|rolling>"
                            set_upload_retention_value "$1"
                            ;;
                        local-target)
                            shift
                            [[ $# -eq 1 ]] || die "usage: antcam upload set local-target <path>"
                            set_upload_local_target_value "$1"
                            ;;
                        remote)
                            shift
                            [[ $# -eq 1 ]] || die "usage: antcam upload set remote <rclone-remote>"
                            set_upload_remote_value "$1"
                            ;;
                        remote-path)
                            shift
                            [[ $# -eq 1 ]] || die "usage: antcam upload set remote-path <path>"
                            set_upload_remote_path_value "$1"
                            ;;
                        watermark-high)
                            shift
                            [[ $# -eq 1 ]] || die "usage: antcam upload set watermark-high <percent>"
                            set_upload_watermark_high_value "$1"
                            ;;
                        watermark-low)
                            shift
                            [[ $# -eq 1 ]] || die "usage: antcam upload set watermark-low <percent>"
                            set_upload_watermark_low_value "$1"
                            ;;
                        *)
                            die "unknown upload set target: $1"
                            ;;
                    esac
                    ;;
                report)
                    shift
                    if [[ $# -eq 0 ]]; then
                        report_upload_settings
                        return 0
                    fi
                    case "$1" in
                        queue)
                            shift
                            [[ $# -eq 0 ]] || die "usage: antcam upload report queue"
                            report_upload_queue
                            ;;
                        targets)
                            shift
                            [[ $# -eq 0 ]] || die "usage: antcam upload report targets"
                            report_upload_targets
                            ;;
                        *)
                            die "unknown upload report target: $1"
                            ;;
                    esac
                    ;;
                test)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam upload test"
                    run_upload_test_once
                    ;;
                pause)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam upload pause"
                    set_upload_pause_value "true"
                    ;;
                resume)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam upload resume"
                    set_upload_pause_value "false"
                    ;;
                reload)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam upload reload"
                    reload_upload_worker_service
                    ;;
                prune)
                    shift
                    [[ $# -ge 2 ]] || die "usage: antcam upload prune --older-than <duration> [--dry-run]"
                    local older_than_value=""
                    local dry_run="false"
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --older-than)
                                shift
                                [[ $# -ge 1 ]] || die "usage: antcam upload prune --older-than <duration> [--dry-run]"
                                older_than_value="$1"
                                shift
                                ;;
                            --dry-run)
                                dry_run="true"
                                shift
                                ;;
                            *)
                                die "unknown upload prune option: $1"
                                ;;
                        esac
                    done
                    [[ -n "${older_than_value}" ]] || die "usage: antcam upload prune --older-than <duration> [--dry-run]"
                    prune_uploaded_files "${older_than_value}" "${dry_run}"
                    ;;
                *)
                    die "unknown upload command: $1"
                    ;;
            esac
            ;;
        transcode)
            shift
            [[ $# -ge 1 ]] || die "usage: antcam transcode <set|report> ..."
            case "$1" in
                set)
                    shift
                    [[ $# -eq 1 ]] || die "usage: antcam transcode set <off|mux|crf:N>"
                    set_transcode_video_value "$1"
                    ;;
                report)
                    shift
                    [[ $# -eq 0 ]] || die "usage: antcam transcode report"
                    report_transcode_video_value
                    ;;
                *)
                    die "unknown transcode action: $1"
                    ;;
            esac
            ;;
        help|-h|--help|"")
            usage
            ;;
        *)
            die "unknown command: ${cmd}"
            ;;
    esac
}

load_antcam_split_helpers
main "$@"
